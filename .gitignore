# This .gitignore file is scoped to the Unity project under /Witch-Pantry.
#
# Based on the Unity gitignore template, adjusted for this repository layout.
#
.utmp/
/Witch-Pantry/[Ll]ibrary/
/Witch-Pantry/[Tt]emp/
/Witch-Pantry/[Oo]bj/
/Witch-Pantry/[Bb]uild/
/Witch-Pantry/[Bb]uilds/
/Witch-Pantry/[Ll]ogs/
/Witch-Pantry/[Uu]ser[Ss]ettings/
*.log

# By default Unity supports Blender asset imports, *.blend1 files do not need to be committed.
*.blend1
*.blend1.meta

# Memory captures can become extremely large.
/Witch-Pantry/[Mm]emoryCaptures/

# Recordings can get excessive in size.
/Witch-Pantry/[Rr]ecordings/

# Uncomment this line if you want to ignore the Asset Store tools plugin.
# /Witch-Pantry/[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin.
/Witch-Pantry/[Aa]ssets/Plugins/Editor/JetBrains*

# JetBrains Rider local settings.
*.DotSettings.user
*.sln.iml
/Witch-Pantry/.idea/
/Witch-Pantry/.fleet/
/.idea

# Visual Studio cache directory.
.vs/

# Gradle cache directory.
.gradle/

# Autogenerated VS/MD/Consulo solution and project files.
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files.
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports.
sysinfo.txt

# Mono autogenerated files.
mono_crash.*

# Builds.
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file.
crashlytics-build.properties

# TestRunner generated files.
InitTestScene*.unity*

# Addressables default ignores, before user customizations.
/Witch-Pantry/ServerData
/Witch-Pantry/[Aa]ssets/StreamingAssets/aa*
/Witch-Pantry/[Aa]ssets/AddressableAssetsData/link.xml*
/Witch-Pantry/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Witch-Pantry/Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/Witch-Pantry/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting autogenerated files.
/Witch-Pantry/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/Witch-Pantry/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/Witch-Pantry/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/Witch-Pantry/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests.
/Witch-Pantry/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Local Codex session memory.
SESSION_SUMMARY.local.md

# Autogenerated images from codex
/output
/tmp